---
import { asc } from 'drizzle-orm';
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllPublishers } from '../lib/publishers';
import { categories } from '../../db/schema';

export const prerender = true;

const db = getDatabase();
const games = await getAllGames(db);
const publishers = await getAllPublishers(db);
const categoryRows = await db
    .select({
        id: categories.id,
        name: categories.name,
    })
    .from(categories)
    .orderBy(asc(categories.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 rounded-2xl border border-slate-700 bg-slate-800/60 p-5 shadow-lg" data-testid="filters-panel">
      <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <div class="flex-1">
          <p class="mb-3 text-sm font-medium uppercase tracking-[0.2em] text-slate-300">Filter games</p>
          <div class="flex flex-wrap gap-3">
            {categoryRows.map((category) => (
              <label class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-slate-600 bg-slate-900/80 px-3 py-2 text-sm text-slate-100 transition-colors hover:border-blue-500/60 hover:bg-slate-800 focus-within:ring-2 focus-within:ring-blue-500 focus-within:outline-none" data-testid={`filter-category-label-${category.id}`}>
                <input
                  type="checkbox"
                  value={String(category.id)}
                  data-category-id={String(category.id)}
                  data-filter-category={String(category.id)}
                  data-testid={`filter-category-${category.id}`}
                  aria-label={`Filter by ${category.name}`}
                  class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-blue-500"
                />
                <span>{category.name}</span>
              </label>
            ))}
          </div>
        </div>

        <div class="w-full max-w-sm">
          <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-300">Publisher</label>
          <select
            id="publisher-filter"
            data-testid="publisher-filter"
            aria-label="Filter by publisher"
            class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="all">All publishers</option>
            {publishers.map((publisher) => (
              <option value={String(publisher.id)}>{publisher.name}</option>
            ))}
          </select>
        </div>
      </div>

      <div class="mt-4 flex items-center justify-between gap-3 border-t border-slate-700 pt-4">
        <p class="text-sm text-slate-300" data-testid="games-results-count">{games.length} games</p>
        <button
          type="button"
          data-testid="clear-filters"
          class="rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-sm font-medium text-slate-100 transition-colors hover:border-blue-500 hover:text-blue-200 focus:outline-none focus:ring-2 focus:ring-blue-500"
        >
          Clear filters
        </button>
      </div>
    </div>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="hidden" data-testid="games-empty-state">
            <EmptyState text="No games match the selected filters." />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
        </>
      )}
    </div>
  </div>

  <script>
    const categoryInputs = Array.from(document.querySelectorAll<HTMLInputElement>('[data-filter-category]'));
    const publisherSelect = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
    const clearFiltersButton = document.querySelector<HTMLButtonElement>('[data-testid="clear-filters"]');
    const countElement = document.querySelector<HTMLElement>('[data-testid="games-results-count"]');
    const emptyState = document.querySelector<HTMLElement>('[data-testid="games-empty-state"]');
    const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));

    const updateResults = () => {
      const selectedCategories = categoryInputs
        .filter((input) => input.checked)
        .map((input) => input.getAttribute('data-filter-category') ?? '');
      const selectedPublisherId = publisherSelect && publisherSelect.value !== 'all'
        ? Number(publisherSelect.value)
        : null;

      let visibleCount = 0;

      gameCards.forEach((card) => {
        const categoryIds = (card.getAttribute('data-category-ids') ?? '')
          .split(',')
          .filter(Boolean);
        const publisherId = card.getAttribute('data-publisher-id');

        const matchesCategory = selectedCategories.length === 0 || selectedCategories.some((id) => categoryIds.includes(id));
        const matchesPublisher = selectedPublisherId === null || Number(publisherId) === selectedPublisherId;
        const isVisible = matchesCategory && matchesPublisher;

        card.hidden = !isVisible;
        if (isVisible) {
          visibleCount += 1;
        }
      });

      if (countElement) {
        countElement.textContent = `${visibleCount} game${visibleCount === 1 ? '' : 's'}`;
      }

      if (emptyState) {
        emptyState.classList.toggle('hidden', visibleCount !== 0);
      }
    };

    categoryInputs.forEach((input) => input.addEventListener('change', updateResults));
    publisherSelect?.addEventListener('change', updateResults);
    clearFiltersButton?.addEventListener('click', () => {
      categoryInputs.forEach((input) => {
        input.checked = false;
      });
      if (publisherSelect) {
        publisherSelect.value = 'all';
      }
      updateResults();
    });

    updateResults();
  </script>
</Layout>
